# App — required on hosted preview (Vercel) so Paystack callbacks return to this origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres — Neon pooled URL for the app. Use the direct (unpooled) URL for migrations
# if the pooler rejects them: set DATABASE_URL_UNPOOLED and run `npm run db:migrate`.
# Local: postgresql://naijadeploy:naijadeploy@127.0.0.1:5432/naijadeploy
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth — openssl rand -base64 32
# BETTER_AUTH_URL must match the origin users sign in on (OAuth callback base).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (not a GitHub App). Callback:
# {BETTER_AUTH_URL}/api/auth/callback/github
# Leave empty to keep email/password only; the GitHub button explains that it is unset.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. 32-byte key, base64 (openssl rand -base64 32). Required before env-var values are written.
ENV_ENCRYPTION_KEY=

# Optional. Password reset email. Without it, development logs the reset link on the server.
RESEND_API_KEY=
RESEND_FROM=

# Paystack — leave empty to use demo checkout at /checkout
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
